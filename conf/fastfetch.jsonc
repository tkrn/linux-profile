{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "localip", 
    "memory",
    {
      "type": "disk",
      "showZfs": true
    },
    {
      "type": "zpool",
      "format": "{name} {state} {size-used}/{size-total} ({used-percentage})"
    }
  ]
}
