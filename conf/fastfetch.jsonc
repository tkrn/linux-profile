{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "localip", 
    "memory",
    {
      "type": "disk",
      "showZfs": true
    },
    {
      "type": "command",
      "key": "ZFS",
      "text": "command -v zpool >/dev/null && zpool list -H -o name,alloc,size,capacity | awk 'BEGIN{pad=\"                                                    \"}{pct=$4; gsub(\"%\",\"\",pct); bars=int(pct/5); printf \"%s%-10s [\", (NR==1?\"\":pad), $1; for(i=0;i<bars;i++) printf \"#\"; for(i=bars;i<20;i++) printf \"-\"; printf \"] %s%%  %s/%s\\n\", pct,$2,$3}'"
    } 
  ]
}
